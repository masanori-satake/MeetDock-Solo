{
  "name": "meetdock-solo",
  "displayName": "MeetDock-Solo",
  "publisher": "masanori-satake",
  "version": "1.4.0",
  "description": "Prevent missing Teams meetings while coding. A lightweight, 100% local VSCode extension.",
  "author": {
    "name": "Masanori Satake"
  },
  "license": "MIT",
  "icon": "icon.png",
  "categories": [
    "Productivity",
    "Other"
  ],
  "keywords": [
    "teams",
    "meeting",
    "reminder",
    "productivity",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/masanori-satake/MeetDock-Solo.git"
  },
  "bugs": {
    "url": "https://github.com/masanori-satake/MeetDock-Solo/issues"
  },
  "homepage": "https://github.com/masanori-satake/MeetDock-Solo#readme",
  "engines": {
    "vscode": "^1.137.0"
  },
  "activationEvents": [
    "onView:meetdock-view"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "meetdock-container",
          "title": "MeetDock-Solo",
          "icon": "$(calendar)"
        }
      ]
    },
    "views": {
      "meetdock-container": [
        {
          "id": "meetdock-view",
          "name": "Meetings"
        }
      ]
    },
    "commands": [
      {
        "command": "meetdock-solo.addFromClipboard",
        "title": "MeetDock: クリップボードから会議を追加",
        "icon": "$(add)"
      },
      {
        "command": "meetdock-solo.openMeeting",
        "title": "Teamsに参加",
        "icon": "$(link-external)"
      },
      {
        "command": "meetdock-solo.deleteMeeting",
        "title": "会議を削除",
        "icon": "$(trash)"
      },
      {
        "command": "meetdock-solo.refreshView",
        "title": "更新",
        "icon": "$(refresh)"
      },
      {
        "command": "meetdock-solo.selectMeeting",
        "title": "MeetDock: ミーティング一覧から選択"
      }
    ],
    "keybindings": [
      {
        "command": "meetdock-solo.addFromClipboard",
        "key": "alt+m",
        "mac": "option+m"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "meetdock-solo.addFromClipboard",
          "when": "view == meetdock-view",
          "group": "navigation"
        },
        {
          "command": "meetdock-solo.refreshView",
          "when": "view == meetdock-view",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "meetdock-solo.openMeeting",
          "when": "view == meetdock-view",
          "group": "inline"
        },
        {
          "command": "meetdock-solo.deleteMeeting",
          "when": "view == meetdock-view",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-version && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-version && npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run check-version && npm run compile-tests && npm run compile && npm run lint",
    "check-version": "node scripts/check-version.js",
    "update-version": "node scripts/update-version.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
